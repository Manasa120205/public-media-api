# ==============================================================================
# PublicMedia API - Environment Configuration Template
# ==============================================================================

# Server & Runtime Environment
PORT=3000
NODE_ENV=development

# CORS Configuration
# For development use "*" or "http://localhost:5173"
# In production, set to your exact frontend domain, e.g. "https://yourfrontend.com"
CORS_ORIGIN=*

# Optional API-Key Authentication
# If set to true, requests require Header: Authorization: Bearer <API_KEY>
API_AUTH_ENABLED=false
API_KEY=dev-secret-api-key-replace-in-production

# Monthly Development Quota Configuration
# Controls global/monthly download request tracking
MONTHLY_QUOTA_ENABLED=true
MONTHLY_DOWNLOAD_LIMIT=5000

# Per-IP Rate Limiting (Requests per 15-minute window)
RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT=100
ANALYZE_RATE_LIMIT=60
DOWNLOAD_RATE_LIMIT=30

# Request Timeout (in milliseconds)
REQUEST_TIMEOUT_MS=15000

# Media Provider Configuration
# Options: "live" (100% free unlimited open-source extractor), "mock" (offline dev), "external", "oembed"
MEDIA_PROVIDER=live

# External Provider Configuration (used when MEDIA_PROVIDER=external)
EXTERNAL_PROVIDER_URL=
EXTERNAL_PROVIDER_API_KEY=

# Optional Instagram Official Graph API / oEmbed credentials (if using Meta APIs)
INSTAGRAM_API_KEY=
INSTAGRAM_ACCESS_TOKEN=

# Temporary Storage & File Cleanup Settings
TEMP_STORAGE_DIR=./temp
STORAGE_CLEANUP_INTERVAL_MS=300000
STORAGE_FILE_MAX_AGE_MS=600000
